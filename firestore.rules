// Merge with the deployed project rules; do not remove other collections.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      function owner() { return request.auth != null && request.auth.uid == uid; }
      function publicRole() {
        let data = request.resource.data;
        return (data.role == 'customer' && !('approvalStatus' in data))
          || (data.role == 'shop' && data.approvalStatus == 'pending');
      }
      allow get: if owner();
      allow list: if false;
      allow create: if owner()
        && request.resource.data.keys().hasOnly(['uid', 'fullName', 'email', 'phone', 'role', 'createdAt', 'approvalStatus'])
        && request.resource.data.keys().hasAll(['uid', 'fullName', 'email', 'phone', 'role', 'createdAt'])
        && request.resource.data.uid == uid
        && publicRole()
        && request.resource.data.fullName is string
        && request.resource.data.email == request.auth.token.email
        && (request.resource.data.phone == null || request.resource.data.phone is string)
        && request.resource.data.createdAt == request.time;
      // Profile role and approval decisions are never client-editable.
      allow update: if false;
      allow delete: if false;
    }
  }
}
